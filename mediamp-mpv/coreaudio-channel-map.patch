-static bool init_audiounit(struct ao *ao, AudioStreamBasicDescription asbd, AudioChannelLayout *layout, size_t layout_size)
+static void init_channel_map(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+    AudioStreamBasicDescription out_asbd;
+    uint32_t size = sizeof(out_asbd);
+    OSStatus err = AudioUnitGetProperty(p->audio_unit,
+                                       kAudioUnitProperty_StreamFormat,
+                                       kAudioUnitScope_Output, 0, &out_asbd, &size);
+    if (!CHECK_CA_WARN("unable to get the output format of the audio unit"))
+        return;
+
+    // A channel map describes a permutation, not mixing or an unknown layout.
+    if (out_asbd.mChannelsPerFrame != ao->channels.num) {
+        MP_VERBOSE(ao, "using default channel map for %u output channels\n",
+                   (unsigned)out_asbd.mChannelsPerFrame);
+        return;
+    }
+
+    struct mp_chmap device_map;
+    ca_get_active_chmap(ao, p->device, ao->channels.num, &device_map);
+    if (!mp_chmap_is_valid(&device_map) || mp_chmap_is_unknown(&device_map) ||
+        !mp_chmap_equals_reordered(&ao->channels, &device_map))
+        return;
+
+    // ChannelMap requires one SInt32 source index per output channel.
+    SInt32 channel_map[MP_NUM_CHANNELS];
+    mp_chmap_get_reorder(channel_map, &ao->channels, &device_map);
+    err = AudioUnitSetProperty(p->audio_unit,
+                              kAudioOutputUnitProperty_ChannelMap,
+                              kAudioUnitScope_Output, 0, channel_map,
+                              ao->channels.num * sizeof(channel_map[0]));
+    CHECK_CA_WARN("unable to set the channel map on the audio unit");
+}
